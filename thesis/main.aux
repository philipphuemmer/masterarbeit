\newlabel{tab:paired_tests}{{4}{48}{Paired statistical tests for key comparisons (500 matched seeds each). Cohen's $d$ is the primary criterion for practical relevance; $p$-values are from the paired $t$-test and Wilcoxon signed-rank test.\relax }{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Cohen's $d$ for all key comparisons. Dashed vertical lines mark conventional thresholds (small: 0.20, medium: 0.50, large: 0.80). Zone-selection effects are the only comparisons with a large effect size; all other comparisons fall below the medium threshold ($d = 0.50$).\relax }}{50}{figure.caption.14}\protected@file@percent }
\newlabel{fig:cohens_d}{{10}{50}{Cohen's $d$ for all key comparisons. Dashed vertical lines mark conventional thresholds (small: 0.20, medium: 0.50, large: 0.80). Zone-selection effects are the only comparisons with a large effect size; all other comparisons fall below the medium threshold ($d = 0.50$).\relax }{figure.caption.14}{}}
