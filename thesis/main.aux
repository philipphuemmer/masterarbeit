\newlabel{fig:seed497}{{7}{43}{Cumulative costs (top) and daily disruption counts (bottom) for Myopic and CFA under value-based zone selection, seed~497 (single run). The dashed vertical line marks day~9, where the gap widens most sharply. Myopic total: €\,52{,}491; CFA total: €\,37{,}191.\relax }{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Rollout effect per policy. All variants use value-based zone selection (500 runs each). Override rate = mean replan overrides / mean total carryover ($\approx $48).\relax }}{44}{table.caption.10}\protected@file@percent }
\newlabel{tab:rollout}{{3}{44}{Rollout effect per policy. All variants use value-based zone selection (500 runs each). Override rate = mean replan overrides / mean total carryover ($\approx $48).\relax }{table.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Distribution of paired cost differences (base minus rollout) per run for each policy, shown as histograms with 500\,€ bins. Positive values indicate the rollout lowered cost; negative values indicate the rollout increased cost. The dashed vertical line marks zero. The x-axis is clipped to $\pm $4{,}000\,€; a small number of extreme values (up to $\pm $6{,}260\,€) fall outside the plotted range. All variants use value-based zone selection (500 runs each). The annotation shows the share of runs in which the rollout produced a strictly lower cost.\relax }}{45}{figure.caption.11}\protected@file@percent }
\newlabel{fig:rollout_delta}{{8}{45}{Distribution of paired cost differences (base minus rollout) per run for each policy, shown as histograms with 500\,€ bins. Positive values indicate the rollout lowered cost; negative values indicate the rollout increased cost. The dashed vertical line marks zero. The x-axis is clipped to $\pm $4{,}000\,€; a small number of extreme values (up to $\pm $6{,}260\,€) fall outside the plotted range. All variants use value-based zone selection (500 runs each). The annotation shows the share of runs in which the rollout produced a strictly lower cost.\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Distribution of replan overrides per run for all four rollout variants (500 runs each). Dashed vertical line shows the mean.\relax }}{45}{figure.caption.12}\protected@file@percent }
