\newlabel{tab:paired_tests}{{5}{51}{Paired statistical tests for key comparisons (500 matched seeds each). Cohen's $d$ is the primary criterion for practical relevance, and $p$-values are from the paired $t$-test and Wilcoxon signed-rank test.\relax }{table.caption.16}{}}
