\newlabel{tab:rollout}{{3}{46}{Rollout effect per policy. All variants use value-based zone selection (500 runs each). Override rate = mean replan overrides / mean total carryover ($\approx $48).\relax }{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Distribution of paired cost differences (base minus rollout) per run for each policy, shown as histograms with 250\,€ bins. Positive values indicate the rollout lowered cost, and negative values indicate the rollout increased cost. The dashed vertical line marks zero. Runs with $\Delta = 0$ (no override was triggered) are excluded from the histogram and reported separately in the annotation. The x-axis is clipped to $\pm $4{,}000\,€, and a small number of extreme values fall outside the plotted range. All variants use value-based zone selection (500 runs each).\relax }}{47}{figure.caption.13}\protected@file@percent }
\newlabel{fig:rollout_delta}{{10}{47}{Distribution of paired cost differences (base minus rollout) per run for each policy, shown as histograms with 250\,€ bins. Positive values indicate the rollout lowered cost, and negative values indicate the rollout increased cost. The dashed vertical line marks zero. Runs with $\Delta = 0$ (no override was triggered) are excluded from the histogram and reported separately in the annotation. The x-axis is clipped to $\pm $4{,}000\,€, and a small number of extreme values fall outside the plotted range. All variants use value-based zone selection (500 runs each).\relax }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Distribution of replan overrides per run for all four rollout variants (500 runs each). Dashed vertical line shows the mean.\relax }}{48}{figure.caption.14}\protected@file@percent }
