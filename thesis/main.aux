\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Mean service day per zone for CFA under centrality-based (left) and value-based (right) zone selection, averaged over 500 runs. Green = serviced early, red = serviced late. Under centrality, the service order is strictly concentric, with zones near the depot always visited first and outer zones last. Value-based selection breaks this pattern, pulling economically critical zones forward to early service days regardless of geographic distance from the depot.\relax }}{42}{figure.caption.9}\protected@file@percent }
\newlabel{fig:zone_maps}{{7}{42}{Mean service day per zone for CFA under centrality-based (left) and value-based (right) zone selection, averaged over 500 runs. Green = serviced early, red = serviced late. Under centrality, the service order is strictly concentric, with zones near the depot always visited first and outer zones last. Value-based selection breaks this pattern, pulling economically critical zones forward to early service days regardless of geographic distance from the depot.\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Total cost distributions for all four policies under centrality (light) and value-based (dark) zone selection (500 runs each). Boxes show interquartile range, and whiskers extend to 1.5$\times $IQR.\relax }}{43}{figure.caption.10}\protected@file@percent }
\newlabel{fig:zone_boxplot}{{8}{43}{Total cost distributions for all four policies under centrality (light) and value-based (dark) zone selection (500 runs each). Boxes show interquartile range, and whiskers extend to 1.5$\times $IQR.\relax }{figure.caption.10}{}}
