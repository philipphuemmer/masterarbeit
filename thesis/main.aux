\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Mean service day per zone for CFA under centrality-based (left) and value-based (right) zone selection, averaged over 500 runs. Green = serviced early, red = serviced late. Under centrality, the service order is strictly concentric: zones near the depot are always visited first, outer zones last. Value-based selection breaks this pattern -- economically critical zones are pulled forward to early service days regardless of geographic distance from the depot.\relax }}{39}{figure.caption.7}\protected@file@percent }
\newlabel{fig:zone_maps}{{5}{39}{Mean service day per zone for CFA under centrality-based (left) and value-based (right) zone selection, averaged over 500 runs. Green = serviced early, red = serviced late. Under centrality, the service order is strictly concentric: zones near the depot are always visited first, outer zones last. Value-based selection breaks this pattern -- economically critical zones are pulled forward to early service days regardless of geographic distance from the depot.\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Total cost distributions for all four policies under centrality (light) and value-based (dark) zone selection (500 runs each). Boxes show interquartile range; whiskers extend to 1.5$\times $IQR.\relax }}{40}{figure.caption.8}\protected@file@percent }
\newlabel{fig:zone_boxplot}{{6}{40}{Total cost distributions for all four policies under centrality (light) and value-based (dark) zone selection (500 runs each). Boxes show interquartile range; whiskers extend to 1.5$\times $IQR.\relax }{figure.caption.8}{}}
