\newlabel{fig:seed497}{{9}{45}{Cumulative costs (top) and daily disruption counts (bottom) for Myopic and CFA under value-based zone selection, seed~497 (single run). The dashed vertical line marks day~9, where the gap widens most sharply. Myopic total: €\,52{,}491; CFA total: €\,37{,}191.\relax }{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Rollout effect per policy. All variants use value-based zone selection (500 runs each). Override rate = mean replan overrides / mean total carryover ($\approx $48).\relax }}{46}{table.caption.12}\protected@file@percent }
\newlabel{tab:rollout}{{3}{46}{Rollout effect per policy. All variants use value-based zone selection (500 runs each). Override rate = mean replan overrides / mean total carryover ($\approx $48).\relax }{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Distribution of paired cost differences (base minus rollout) per run for each policy, shown as histograms with 500\,€ bins. Positive values indicate the rollout lowered cost, and negative values indicate the rollout increased cost. The dashed vertical line marks zero. The x-axis is clipped to $\pm $4{,}000\,€, and a small number of extreme values (up to $\pm $6{,}260\,€) fall outside the plotted range. All variants use value-based zone selection (500 runs each). The annotation shows the share of runs in which the rollout produced a strictly lower cost.\relax }}{47}{figure.caption.13}\protected@file@percent }
\newlabel{fig:rollout_delta}{{10}{47}{Distribution of paired cost differences (base minus rollout) per run for each policy, shown as histograms with 500\,€ bins. Positive values indicate the rollout lowered cost, and negative values indicate the rollout increased cost. The dashed vertical line marks zero. The x-axis is clipped to $\pm $4{,}000\,€, and a small number of extreme values (up to $\pm $6{,}260\,€) fall outside the plotted range. All variants use value-based zone selection (500 runs each). The annotation shows the share of runs in which the rollout produced a strictly lower cost.\relax }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Distribution of replan overrides per run for all four rollout variants (500 runs each). Dashed vertical line shows the mean.\relax }}{47}{figure.caption.14}\protected@file@percent }
\newlabel{fig:rollout_overrides}{{11}{47}{Distribution of replan overrides per run for all four rollout variants (500 runs each). Dashed vertical line shows the mean.\relax }{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Statistical Validation}{49}{subsection.7.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Paired statistical tests for key comparisons (500 matched seeds each). Cohen's $d$ is the primary criterion for practical relevance, and $p$-values are from the paired $t$-test and Wilcoxon signed-rank test.\relax }}{50}{table.caption.15}\protected@file@percent }
\newlabel{tab:paired_tests}{{4}{50}{Paired statistical tests for key comparisons (500 matched seeds each). Cohen's $d$ is the primary criterion for practical relevance, and $p$-values are from the paired $t$-test and Wilcoxon signed-rank test.\relax }{table.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Cohen's $d$ for all key comparisons. Dashed vertical lines mark conventional thresholds (small: 0.20, medium: 0.50, large: 0.80). Zone-selection effects are the only comparisons with a large effect size, and all other comparisons fall below the medium threshold ($d = 0.50$).\relax }}{52}{figure.caption.16}\protected@file@percent }
